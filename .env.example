
# Native build execution: docker (recommended production), local (controlled development), or unset for compatibility fallback.
NATIVE_BUILD_EXECUTION_MODE=docker
NATIVE_BUILDER_IMAGE=minhas/native-builder:latest
NATIVE_BUILDER_NETWORK=none
NATIVE_BUILDER_NETWORK_ALLOWLISTED=false
BUILD_WORKER_CONCURRENCY=1
BUILD_WORKER_LEASE_MS=120000
BUILD_MAX_ATTEMPTS=3
NATIVE_ARTIFACT_ROOT=.native-artifacts
ARTIFACT_SIGNING_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_DOMAIN=

API_RATE_LIMIT_DISTRIBUTED=false
API_RATE_LIMIT=120


