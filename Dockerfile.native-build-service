FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4100

RUN npm install --global pnpm@9.12.0
COPY package.json pnpm-lock.yaml ./
COPY scripts/install-git-hooks.mjs ./scripts/install-git-hooks.mjs
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec esbuild server/native-build-service/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/native-build-service.js

RUN mkdir -p /var/lib/minhas/native-workspaces /var/lib/minhas/native-artifacts \
    && chown -R node:node /app /var/lib/minhas
USER node
EXPOSE 4100
CMD ["node", "dist/native-build-service.js"]
