{
  "name": "minhas-ai-builder",
  "version": "4.8.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "NODE_ENV=production pnpm exec expo export --platform web --output-dir dist/client && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate && node scripts/apply-custom-migrations.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "preflight": "node scripts/preflight.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "verify:production": "pnpm run check && pnpm run lint && pnpm test && pnpm run preflight && pnpm run production:preflight && pnpm run native-worker:selftest && pnpm run native-build-service:selftest && pnpm run native-build-queue:selftest && pnpm run native-artifact:selftest && pnpm run native-build-worker:selftest && pnpm run native-signing:selftest && pnpm run native-build-docker:selftest && pnpm run native-build-execution:selftest && pnpm run build && pnpm run release:v42-selftest && pnpm run release:v43-selftest && pnpm run feature-structure:selftest && pnpm run runtime-safety:selftest",
    "native-worker:selftest": "node scripts/native-worker-selftest.mjs",
    "native-build-service": "cross-env NODE_ENV=production tsx server/native-build-service/index.ts",
    "native-build-service:test": "vitest run server/native-build-service/service.test.ts",
    "native-build-service:selftest": "node scripts/native-build-service-selftest.mjs",
    "native-build-queue:selftest": "node scripts/native-build-queue-selftest.mjs",
    "native-artifact:selftest": "node scripts/native-artifact-selftest.mjs",
    "native-build-worker:selftest": "node scripts/native-build-worker-selftest.mjs",
    "native-signing:selftest": "node scripts/native-signing-selftest.mjs",
    "native-build-docker:selftest": "node scripts/native-build-docker-selftest.mjs",
    "native-build-execution:selftest": "node scripts/native-build-execution-selftest.mjs",
    "release:certify": "node scripts/release-certification.mjs",
    "release:regression": "node scripts/release-regression.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "release:live": "node scripts/live-release-certification.mjs",
    "release:control:selftest": "node scripts/release-control-selftest.mjs",
    "release:v41-selftest": "node scripts/release-v41-selftest.mjs",
    "release:v42-selftest": "node scripts/release-v42-selftest.mjs",
    "release:v43-selftest": "node scripts/release-v43-selftest.mjs",
    "e2e": "playwright test",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "feature-structure:selftest": "node scripts/feature-structure-selftest.mjs",
    "runtime-safety:selftest": "node scripts/runtime-safety-selftest.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "verify:full": "pnpm run check && pnpm run lint && pnpm test && pnpm run build && pnpm run e2e && pnpm run preflight && pnpm run production:preflight && pnpm run security:audit && pnpm run feature-structure:selftest && pnpm run runtime-safety:selftest && pnpm run release:v48-selftest",
    "release:v46-certify": "node scripts/v46-certification.mjs",
    "dependency:doctor": "node scripts/dependency-doctor.mjs",
    "release:final-gate": "pnpm run release:v48-certify",
    "release:v47-selftest": "node scripts/release-v47-selftest.mjs",
    "release:v47-certify": "node scripts/v47-certification.mjs",
    "release:v48-selftest": "node scripts/release-v48-selftest.mjs",
    "release:v48-certify": "node scripts/v48-certification.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.29",
    "expo-audio": "~1.1.0",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "jszip": "^3.10.1",
    "mysql2": "^3.16.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.55.0",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0"
}
