FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

RUN npm install --global pnpm@9.12.0
COPY package.json pnpm-lock.yaml ./
COPY scripts/install-git-hooks.mjs ./scripts/install-git-hooks.mjs
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec esbuild server/native-worker/cli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/native-worker.js

RUN useradd --create-home --shell /usr/sbin/nologin builder \
    && mkdir -p /workspace /artifacts /run/minhas \
    && chown -R builder:builder /app /workspace /artifacts /run/minhas
USER builder
WORKDIR /workspace
CMD ["node", "/app/dist/native-worker.js"]
